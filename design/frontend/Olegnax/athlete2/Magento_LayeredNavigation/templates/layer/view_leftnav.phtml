use Magento\LayeredNavigation\Block\Navigation;
?>
<?php
/**
 * Category layered navigation
 *
 * @var $block Navigation
 */
?>
<?php if ($block->canShowBlock()) : ?>
    <div class="block filter filters-slideout-content ox-move-item ox-move-item-filtersslideout" id="layered-filter-block">
        <?php include($block->getTemplateFile('Magento_LayeredNavigation::layer/close-sidebar.phtml')); ?>
        <?php $filtered = count($block->getLayer()->getState()->getFilters()) ?>
        <div class="block-title filter-title" data-count="<?= /* @noEscape */ $filtered ?>">
            <strong data-role="title"><?= $block->escapeHtml(__('Shop By')); ?></strong>
        </div>
        <div class="block-content filter-content">
            <?= $block->getChildHtml('state') ?>

            <?php if ($block->getLayer()->getState()->getFilters()) : ?>
                <div class="block-actions filter-actions">
                    <a href="<?= $block->escapeUrl($block->getClearUrl()) ?>" class="action clear button filter-clear">
                        <span><?= $block->escapeHtml(__('Clear All')) ?></span>
                    </a>
                </div>
            <?php endif; ?>

            <?php foreach ($block->getFilters() as $filter) : ?>
                <?php if ($filter->getItemsCount()) : ?>
                    <?php $closed = $this->helper('Olegnax\Athlete2\Helper\ProductList')->isFilterToggleClosed($filter); ?>
                    <div data-role="collapsible" class="filter-options filter-options-item collapsible <?php if (!$closed) { ?>open<?php } ?>">
                        <div data-role="title" class="filter-options-title">
                            <strong><?= $block->escapeHtml(__($filter->getName())) ?></strong>
                            <div class="toggle-minus"><span></span></div>
                        </div>
                        <div data-role="content" class="filter-options-content" <?php if ($closed) { ?>style="display:none;" <?php } ?>>
                            <!-- Filter Search Input -->
                            <div class="layered-filter-search" style="position: sticky; top: 0; background-color: #fff; z-index: 10; padding: 6px;">
                                <input type="text" class="filter-search" placeholder="<?= __('Search Filters...') ?>" style="width: 100%; padding: 6px;">
                            </div>
                            <!-- Scrollable List -->
                            <div class="filter-items-container" style="max-height: 300px; overflow-y: auto; padding-top: 10px;">
                                <?= /* @escapeNotVerified */ $block->getChildBlock('renderer')->render($filter) ?>
                            </div>
                        </div>
                    </div>
                <?php endif; ?>
            <?php endforeach; ?>
        </div>
    </div>
    <style>
        .layered-filter-search input.filter-search {
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
        }

        .filter-items-container {
            scrollbar-width: thin;
        }
    </style>
    <!-- JS to handle filter search -->
    <script type="text/javascript">
        require(['jquery'], function($) {
            $(document).ready(function() {
                $('.filter-search').on('keyup', function() {
                    var $this = $(this);
                    var value = $this.val().toLowerCase();
                    var $filterSection = $this.closest('.filter-options-content');

                    $filterSection.find('.filter-items-container li.item').each(function() {
                        var text = $(this).text().toLowerCase();
                        $(this).toggle(text.indexOf(value) > -1);
                    });
                });
            });
        });
    </script>
<?php endif; ?>