<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Xigen\CsvUpload\Api\CsvRepositoryInterface"
        type="Xigen\CsvUpload\Model\CsvRepository" />
    <preference for="Xigen\CsvUpload\Api\Data\CsvInterface" type="Xigen\CsvUpload\Model\Data\Csv" />
    <preference for="Xigen\CsvUpload\Api\Data\CsvSearchResultsInterface"
        type="Magento\Framework\Api\SearchResults" />
    <virtualType name="Xigen\CsvUpload\Model\ResourceModel\Csv\Grid\Collection"
        type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">xigen_csvupload_csv</argument>
            <argument name="resourceModel" xsi:type="string">
                Xigen\CsvUpload\Model\ResourceModel\Csv\Collection</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="xigen_csvupload_csv_listing_data_source" xsi:type="string">
                    Xigen\CsvUpload\Model\ResourceModel\Csv\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\Model\Cart">
        <plugin disabled="false"
            name="xigen_csvupload_Plugin_Magento_Checkout_Cart_BeforeAddToCartProduct"
            type="Xigen\CsvUpload\Plugin\Magento\Checkout\Cart\BeforeAddToCartProduct" />
        <!-- <plugin name="UpdateProductToCart" type="Xigen\CsvUpload\Plugin\Magento\Checkout\Cart\BeforeUpdateQty" /> -->
    </type>
</config>